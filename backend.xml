                registry.addMapping("/**")
                        .allowedOrigins("*") // Permite peticiones de cualquier frontend
                        .allowedMethods("GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS")
                        .allowedHeaders("*");
            }
        };
    }
}
